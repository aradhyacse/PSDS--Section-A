import sys

def solve(n, k, arr):
   
    arr.sort(key=lambda x: (bin(x ^ k).count('1'), x))
    return arr

def main():
    data = sys.stdin.read().split()
    idx = 0
    t = int(data[idx]); idx += 1
    out = []
    for _ in range(t):
        n = int(data[idx]); k = int(data[idx + 1]); idx += 2
        arr = list(map(int, data[idx:idx + n])); idx += n
        res = solve(n, k, arr)
        out.append(' '.join(map(str, res)))
    print('\n'.join(out))

main()
