#include <iostream>
#include <string>
using namespace std;

int main() {
    int T;

    cout << "Enter number of test cases: ";
    cin >> T;

    while (T--) {
        string S;

        cout << "Enter string: ";
        cin >> S;

        int freq[26] = {0};

        for (int i = 0; i < S.length(); i++) {
            freq[S[i] - 'a']++;
        }

        int ans = 0;

        for (int i = 0; i < 26; i++) {
            ans += freq[i] / 2;
        }

        cout << "Maximum palindromic subsequences: "
             << ans << endl;
    }

    return 0;
}
