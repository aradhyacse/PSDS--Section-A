import sys

def solve():
    n, m, k = map(int, sys.stdin.readline().split())
    
    edges = []
    for _ in range(m):
        u, v, w = map(int, sys.stdin.readline().split())
        edges.append((u, v, w))
        
    inf = float('inf')
    dist = [inf] * (n + 1)
    dist[1] = 0
    
    for _ in range(k):
        next_dist = list(dist)
        for u, v, w in edges:
            if dist[u] != inf and dist[u] + w < next_dist[v]:
                next_dist[v] = dist[u] + w
            if dist[v] != inf and dist[v] + w < next_dist[u]:
                next_dist[u] = dist[v] + w
        dist = next_dist
        
    print(dist[n] if dist[n] != inf else -1)

if __name__ == '__main__':
    solve()
