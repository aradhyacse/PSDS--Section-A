n, k = map(int, input("enter the number of integer(n) and size of array(k): ").split())
arr = list(map(int, input().split()))

window_sum = 0
for i in range(k):
    window_sum += arr[i]

max_sum = window_sum

for i in range(k, n):
    window_sum += arr[i]
    window_sum -= arr[i - k]
    max_sum = max(max_sum, window_sum)

print(max_sum)

