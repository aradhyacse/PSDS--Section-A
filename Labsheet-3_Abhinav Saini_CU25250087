#include <iostream>
using namespace std;
struct Node
{
    int data;
    Node *next;
};
Node *top = NULL;

void push(int x)
{
    Node *p = new Node;
    p->data = x;
    p->next = top;
    top = p;
}

void pop()
{
    if (top == NULL)
    {
        cout << "Stack is empty" << endl;
    }
    else
    {
        Node *p = top;
        cout << "Popped: " << p->data << endl;
        top = top->next;
        delete p;
    }
}
void displayStack()
{
    Node *p = top;

    cout << "Stack: ";
    while (p != NULL)
    {
        cout << p->data << " ";
        p = p->next;
    }
    cout << endl;
}
Node *front = NULL;
Node *rear = NULL;

void enqueue(int x)
{
    Node *p = new Node;
    p->data = x;
    p->next = NULL;

    if (rear == NULL)
    {
        front = rear = p;
    }
    else
    {
        rear->next = p;
        rear = p;
    }
}
void dequeue()
{
    if (front == NULL)
    {
        cout << "Queue is empty" << endl;
    }
    else
    {
        Node *p = front;
        cout << "Deleted: " << p->data << endl;
        front = front->next;

        if (front == NULL)
            rear = NULL;

        delete p;
    }
}
void displayQueue()
{
    Node *p = front;

    cout << "Queue: ";
    while (p != NULL)
    {
        cout << p->data << " ";
        p = p->next;
    }
    cout << endl;
}
int main()
{
    cout << "Stack:" << endl;
    push(10);
    push(20);
    push(30);

    displayStack();
    pop();
    displayStack();

    cout << endl << "Queue:" << endl;

    enqueue(10);
    enqueue(20);
    enqueue(30);
    displayQueue()
    dequeue();

    displayQueue();
    return 0;
}
