def digit_sum(x):
    total = 0
    while x > 0:
        total += x % 10
        x //= 10
    return total
def solve():
    n = int(input("Enter size of array: "))
    nums = list(map(int, input("Enter array elements: ").split()))
    count = {}
    for x in nums:
        s = digit_sum(x)
        if s not in count:
            count[s] = 0
        count[s] += 1
    answer = 0
    for value in count.values():
        answer += value * value
    print("Number of special pairs:", answer)
solve()
