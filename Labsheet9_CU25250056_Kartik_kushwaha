#include <iostream>
#include <vector>
using namespace std;

void solve() {
    int N;
    cout << "Enter N: ";
    cin >> N;
    vector<int> A(N);
    long long ans = 0;
    cout << "Enter array elements: ";
    for (int i = 0; i < N; i++) {
        cin >> A[i];
        if (A[i] > 0) {
            cout << "Answer: -1" << endl;
            return;
        }
        ans += -A[i];
    }

    cout << "Minimum operations: " << ans << endl;
}

int main() {
    int T;

    cout << "Enter number of test cases: ";
    cin >> T;

    while (T--) {
        solve();
    }

    return 0;
}
