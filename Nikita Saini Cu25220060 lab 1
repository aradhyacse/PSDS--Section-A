#include <iostream>
#include <vector>
using namespace std;

int main()
{
    vector<int> arr(5);

    cout << "Enter 5 elements:\n";
    for (int i = 0; i < 5; i++)
    {
        cin >> arr[i];
    }

    cout << "\nPopped elements are:\n";
    for (int i = arr.size(); i > 0; i--)
    {
        cout << arr.back() << " ";
        arr.pop_back();
    }

    return 0;
}
