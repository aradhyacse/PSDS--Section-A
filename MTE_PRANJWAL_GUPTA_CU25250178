def solve():
    t = int(input())

    for _ in range(t):
        n, x = map(int, input().split())
        arr = list(map(int, input().split()))

        arr.sort(key=lambda num: (bin(num ^ x).count('1'), num))

        print(*arr)


solve()

"""
-t tells us how many test cases we have.
-n is the number of elements and x is the integer used for comparison.
-num ^ x performs XOR, which identifies the bits that are different.
-bin(...).count('1') counts the different bits.
-sort() arranges the elements by Hamming Distance. If two elements have the same distance, the smaller number comes first.
-print(*arr) prints the sorted array.
"""
