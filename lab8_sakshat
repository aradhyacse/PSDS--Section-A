n = int(input("Enter N: "))
k = int(input("Enter K: "))

arr = list(map(int, input("Enter array: ").split()))

window_sum = sum(arr[:k])
max_sum = window_sum

for i in range(k, n):
    window_sum = window_sum - arr[i-k] + arr[i]
    max_sum = max(max_sum, window_sum)

print("Maximum sum =", max_sum)
