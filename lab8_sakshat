n, m, k = map(int, input("Enter N, M, K: ").split())

edges = []

for i in range(m):
    u, v, w = map(int, input("Enter u, v, weight: ").split())
    edges.append((u, v, w))

INF = 10**9
dp = [[INF] * (n + 1) for _ in range(k + 1)]

dp[0][1] = 0

for e in range(1, k + 1):
    for u, v, w in edges:
        if dp[e-1][u] != INF:
            dp[e][v] = min(dp[e][v], dp[e-1][u] + w)

        if dp[e-1][v] != INF:
            dp[e][u] = min(dp[e][u], dp[e-1][v] + w)

answer = min(dp[e][n] for e in range(k + 1))

if answer == INF:
    print(-1)
else:
    print("Minimum path weight =",answer)
