// // Linear search 

#include <iostream>
using namespace std;
int linear_search(int arr[], int n, int key) {
    for(int i=0; i<n;i++) {
        if (arr[i] == key)
        return i;
    }
    return -1;
}

int main() {
    int arr[] = {12,27,34,45,58,63,77};
    int n = 7;
    int key;

    cout << "Enter number : ";
    cin >> key;

    int result = linear_search(arr, n, key);

    if(result != -1)
        cout << "Element found at index: " << result;
    else
        cout << " not found";

    return 0;
}


// Binary Search
#include <iostream>
using namespace std;
int binary_search(int arr[], int n, int key){
    int low =0 ,  high = n-1;
    while (low<=high) {
        int mid = low +(high - low) /2;
        if (arr[mid] == key)
        return mid;
        else if (arr[mid] < key) 
        low = mid+1;
        else 
            high = mid - 1;
    }
    return -1;
}

int main() {
    int arr[] = {12, 27, 34, 45, 58, 63, 77};
    int n = 7;
    int key;

    cout << "Enter number : ";
    cin >> key;

    int result = binary_search(arr, n, key);

    if (result != -1)
        cout << "Element found at index: " << result;
    else
        cout << "not found";

    return 0;
}

