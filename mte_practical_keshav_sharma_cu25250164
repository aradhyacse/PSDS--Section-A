#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        string S;
        cin >> S;

        int freq[26] = {0};

        for (int i = 0; i < S.length(); i++) {
            freq[S[i] - 'a']++;
        }

        int ans = 0;

        for (int i = 0; i < 26; i++) {
            ans += freq[i] / 2;
        }

        cout << ans << endl;
    }

    return 0;
}
