
#include <iostream>
using namespace std;

int stackArr[5];
int top = -1;

void push(int value) {
    if (top == 4) {
        cout << "Stack Overflow\n";
        return;
    }

    top++;
    stackArr[top] = value;
    cout << value << " pushed\n";
}

void pop() {
    if (top == -1) {
        cout << "Stack Underflow\n";
        return;
    }

    cout << "Popped element: " << stackArr[top] << endl;
    top--;
}

void display() {
    cout << "Stack: ";
    for (int i = top; i >= 0; i--) {
        cout << stackArr[i] << " ";
    }
    cout << endl;
}

int main() {
    push(10);
    push(20);
    push(30);

    display();
    pop();
    display();

    return 0;
}
