#include <iostream>
#include <vector>
using namespace std;

int digitSum(int x) {
    int sum = 0;

    while (x > 0) {
        sum += x % 10;
        x /= 10;
    }

    return sum;
}

void solve() {
    int N;

    cout << "Enter N (array size): ";
    cin >> N;

    vector<int> nums(N);

    cout << "Enter array elements: ";
    for (int i = 0; i < N; i++)
        cin >> nums[i];

    int ans = 0;

    for (int i = 0; i < N; i++) {
        for (int j = i + 1; j < N; j++) {
            if (digitSum(nums[i]) == digitSum(nums[j]))
                ans++;
        }
    }

    cout << "Number of special pairs: " << ans << endl;
}

int main() {
    solve();
    return 0;
}
