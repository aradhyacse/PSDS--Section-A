#include <iostream>
#include <stack>
#include <cctype>
using namespace std;

int main() {
    string postfix;
    stack<int> s;

    cout << "Enter Postfix Expression: ";
    cin >> postfix;

    for (char c : postfix) {
        if (isdigit(c))
            s.push(c - '0');
        else {
            int b = s.top(); s.pop();
            int a = s.top(); s.pop();

            switch (c) {
                case '+': s.push(a + b); break;
                case '-': s.push(a - b); break;
                case '*': s.push(a * b); break;
                case '/': s.push(a / b); break;
            }
        }
    }

    cout << "Result = " << s.top();
    return 0;
}

