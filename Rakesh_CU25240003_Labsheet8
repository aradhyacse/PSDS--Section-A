answer = float('inf')

while pq:

    cost, node, edges_used = heapq.heappop(pq)

    if cost != dist[node][edges_used]:
        continue

    if node == n:
        answer = cost
        break

    if edges_used == k:
        continue

    for neighbour, weight in graph[node]:

        new_cost = cost + weight
        new_edges = edges_used + 1

        if new_cost < dist[neighbour][new_edges]:

            dist[neighbour][new_edges] = new_cost

            heapq.heappush(
                pq,
                (new_cost, neighbour, new_edges)
            )

if answer == float('inf'):
    print("Minimum Path Weight: -1")
else:
    print("Minimum Path Weight:", answer)'''
