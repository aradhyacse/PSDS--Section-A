def evaluate_postfix(expression):

    stack = []

    for item in expression.split():

        # Number hai
        if item.isdigit():
            stack.append(int(item))

        # Operator hai
        else:
            b = stack.pop()
            a = stack.pop()

            if item == '+':
                stack.append(a + b)

            elif item == '-':
                stack.append(a - b)

            elif item == '*':
                stack.append(a * b)

            elif item == '/':
                stack.append(a / b)

    return stack.pop()


expression = input("Enter postfix expression with spaces: ")

result = evaluate_postfix(expression)

print("Final Result:", result)
