def digit_sum(num):
    total = 0

    while num > 0:
        total += num % 10
        num //= 10

    return total


def solve():
    n = int(input())
    nums = list(map(int, input().split()))

    count = 0

    for i in range(n):
        for j in range(i + 1, n):
            if digit_sum(nums[i]) == digit_sum(nums[j]):
                count += 1

    print(count)


solve()
