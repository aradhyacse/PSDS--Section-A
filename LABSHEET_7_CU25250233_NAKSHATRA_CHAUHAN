# Rearrange Array to Maximize Adjacent Sum Difference

def maximize_difference(arr):
    arr.sort()
    n = len(arr)

    result = [0] * n
    left = 0
    right = n - 1

    # Alternate between smallest and largest
    for i in range(n):
        if i % 2 == 0:
            result[i] = arr[left]
            left += 1
        else:
            result[i] = arr[right]
            right -= 1

    total = 0
    for i in range(1, n):
        total += abs(result[i] - result[i - 1])

    return result, total


arr = [4, 2, 7, 1]

result, total = maximize_difference(arr)

print("Rearranged Array:", result)
print("Maximum Sum of Differences:", total)

