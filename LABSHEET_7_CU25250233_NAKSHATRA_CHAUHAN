# Min/Max Heap, Priority Queue and Heap SortACTI

class Heap:
    def __init__(self, is_min=True):
        self.heap = []
        self.is_min = is_min

    def compare(self, a, b):
        return a < b if self.is_min else a > b

    def insert(self, value):
        self.heap.append(value)
        i = len(self.heap) - 1

        while i > 0:
            p = (i - 1) // 2
            if self.compare(self.heap[i], self.heap[p]):
                self.heap[i], self.heap[p] = self.heap[p], self.heap[i]
                i = p
            else:
                break

    def delete(self):
        if not self.heap:
            return None

        root = self.heap[0]
        self.heap[0] = self.heap[-1]
        self.heap.pop()

        i = 0
        while True:
            left = 2 * i + 1
            right = 2 * i + 2
            best = i

            if left < len(self.heap) and self.compare(self.heap[left], self.heap[best]):
                best = left
            if right < len(self.heap) and self.compare(self.heap[right], self.heap[best]):
                best = right

            if best == i:
                break

            self.heap[i], self.heap[best] = self.heap[best], self.heap[i]
            i = best

        return root


# Priority Queue using Min Heap
class PriorityQueue:
    def __init__(self):
        self.heap = Heap(True)

    def enqueue(self, value):
        self.heap.insert(value)

    def dequeue(self):
        return self.heap.delete()


# Heap Sort
def heap_sort(arr):
    n = len(arr)

    def heapify(i, size):
        largest = i
        l = 2 * i + 1
        r = 2 * i + 2

        if l < size and arr[l] > arr[largest]:
            largest = l
        if r < size and arr[r] > arr[largest]:
            largest = r

        if largest != i:
            arr[i], arr[largest] = arr[largest], arr[i]
            heapify(largest, size)

    for i in range(n // 2 - 1, -1, -1):
        heapify(i, n)

    for i in range(n - 1, 0, -1):
        arr[0], arr[i] = arr[i], arr[0]
        heapify(0, i)

    return arr


