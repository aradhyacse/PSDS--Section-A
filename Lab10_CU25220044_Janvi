def solve():
    n = int(input())
    nums = list(map(int, input().split()))

    count = 0

    for i in range(n):
        sum_i = sum(map(int, str(abs(nums[i]))))

        for j in range(i + 1, n):
            sum_j = sum(map(int, str(abs(nums[j]))))

            if sum_i == sum_j:
                count += 1

    print(count)


# Main
solve()
