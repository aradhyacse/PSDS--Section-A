#include <iostream>
#include <string>
using namespace std;

int main()
{
    int T;
    cin >> T;

    while (T--)
    {
        string S;
        cin >> S;

        int freq[26] = {0};

        for (int i = 0; i < S.length(); i++)
        {
            freq[S[i] - 'a']++;
        }

        int count = 0;

        for (int i = 0; i < 26; i++)
        {
            count += freq[i] / 2;
        }

        cout << count << endl;
    }

    return 0;
}
