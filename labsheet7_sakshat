def maximize_difference(arr):
    n = len(arr)

    if n <= 1:
        return arr, 0

    if n == 2:
        return arr, abs(arr[0] - arr[1])

    arr.sort()

    m = (n + 1) // 2

    low = arr[:m]
    high = arr[m:]

    result = []

    result.append(low[-1])

    for x in high:
        result.append(x)

        if len(result) < n:
            result.append(low.pop(0))

    if low:
        result.append(low[0])

    total = 0

    for i in range(1, len(result)):
        total += abs(result[i] - result[i - 1])

    return result, total

arr = list(map(int,input("Enter elements:").split()))

result, total = maximize_difference(arr)

print("Original Array:", arr)
print("Rearranged Array:", result)
print("Maximum Sum of Differences:", total)
