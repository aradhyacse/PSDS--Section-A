def solve():
    N = int(input())
    A = list(map(int, input().split()))
    if all(x == 0 for x in A):
        print(0)
        return
    if any(x > 0 for x in A) and any(x < 0 for x in A):
        print(-1)
        return
    print(sum(abs(x) for x in A))


T = int(input())

for _ in range(T):
    solve()
