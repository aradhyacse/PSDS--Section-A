def evaluate_postfix(expression):
    stack = []

    for char in expression:
        if char.isdigit():
            stack.append(int(char))

        elif char in "+-*/^":
            val2 = stack.pop()
            val1 = stack.pop()

            if char == '+':
                stack.append(val1 + val2)
            elif char == '-':
                stack.append(val1 - val2)
            elif char == '*':
                stack.append(val1 * val2)
            elif char == '/':
                stack.append(int(val1 / val2))
            elif char == '^':
                stack.append(val1 ** val2)

    return stack.pop()


if __name__ == "__main__":
    test_postfix = "231*+9-"
    result = evaluate_postfix(test_postfix)
