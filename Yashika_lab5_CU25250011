def infix_to_postfix(expression):
    precedence = {'+': 1, '-': 1, '*': 2, '/': 2, '^': 3}
    stack = []
    output = ""

    for char in expression:
        # If character is a letter or number, add it to output
        if char.isalnum():
            output += char

        # If opening bracket, push to stack
        elif char == '(':
            stack.append(char)

        # If closing bracket, pop until opening bracket
        elif char == ')':
            while stack and stack[-1] != '(':
                output += stack.pop()
            stack.pop()  # Remove '('

        # If operator, pop higher/equal precedence operators, then push
        elif char in precedence:
            while stack and stack[-1] in precedence and precedence[stack[-1]] >= precedence[char]:
                output += stack.pop()
            stack.append(char)

    # Pop remaining operators
    while stack:
        output += stack.pop()

    return output


# Test the code
expr = "A+(B*C)"
print("Answer no 1: ")
print("Infix:  ", expr)
print("Postfix:", infix_to_postfix(expr))

