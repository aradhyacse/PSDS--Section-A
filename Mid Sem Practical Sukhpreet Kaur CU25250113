t = int(input("Enter the number of test cases: "))

for i in range(t):
    s = input("Enter the string: ").strip()

    freq = [0] * 26

    for ch in s:
        freq[ord(ch) - ord('a')] += 1

    ans = sum(count // 2 for count in freq)

    print("Maximum number of palindromic subsequences:", ans)
