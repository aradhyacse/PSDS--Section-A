def solve(N, nums):
    count = 0

    for i in range(N):
        sum1 = 0
        temp = nums[i]

        while temp > 0:
            sum1 += temp % 10
            temp //= 10

        for j in range(i + 1, N):
            sum2 = 0
            temp = nums[j]

            while temp > 0:
                sum2 += temp % 10
                temp //= 10

            if sum1 == sum2:
                count += 1

    return count


N = int(input())
nums = list(map(int, input().split()))

print(solve(N, nums))
