def evaluate_postfix(expression):
    stack = IntegerStack()
    # Split tokens by space to support multi-digit integers
    tokens = expression.split()

    for token in tokens:
        # If the token is a number, push it to the stack
        if token.isdigit() or (token[0] == '-' and token[1:].isdigit()):
