def infix_to_postfix(expression):
    # Define operator precedence
    precedence = {'+': 1, '-': 1, '*': 2, '/': 2, '^': 3}
    
    operator_stack = Stack()
    postfix_output = []
    
    # Remove whitespace from the expression
    expression = expression.replace(" ", "")

    for char in expression:
        # If the character is an operand (letter or number), add it to the output
        if char.isalnum():
            postfix_output.append(char)
        
        # If the character is an opening parenthesis, push it to the stack
        elif char == '(':
            operator_stack.push(char)
        
        # If the character is a closing parenthesis, pop until an opening one is found
        elif char == ')':
            while not operator_stack.is_empty() and operator_stack.peek() != '(':
                postfix_output.append(operator_stack.pop())
            operator_stack.pop()  # Remove the '(' from the stack
        
        # If the character is an operator
        else:
            while (not operator_stack.is_empty() and 
                   operator_stack.peek() != '(' and 
                   precedence.get(operator_stack.peek(), 0) >= precedence.get(char, 0)):
                postfix_output.append(operator_stack.pop())
            operator_stack.push(char)

    # Pop all the remaining operators from the stack
    while not operator_stack.is_empty():
        postfix_output.append(operator_stack.pop())

    return "".join(postfix_output)


