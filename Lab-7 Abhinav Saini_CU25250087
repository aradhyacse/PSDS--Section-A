#ques-3
n, m, k = map(int, input().split())

edges = []

for _ in range(m):
    u, v, w = map(int, input().split())
    edges.append((u, v, w))

INF = float('inf')
dp = [[INF] * (k + 1) for _ in range(n + 1)]

dp[1][0] = 0

for e in range(1, k + 1):
    for u, v, w in edges:
        if dp[u][e - 1] != INF:
            dp[v][e] = min(dp[v][e], dp[u][e - 1] + w)

        if dp[v][e - 1] != INF:
            dp[u][e] = min(dp[u][e], dp[v][e - 1] + w)

answer = min(dp[n])

if answer == INF:
    print(-1)
else:
    print(answer)
