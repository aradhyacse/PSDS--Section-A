def digit_sum(n):
    total = 0

    while n > 0:
        total += n % 10
        n //= 10

    return total


def solve():
    N = int(input())
    nums = list(map(int, input().split()))

    count = {}
    answer = 0

    for x in nums:
        s = digit_sum(x)

        if s in count:
            answer += count[s]

        count[s] = count.get(s, 0) + 1

    print(answer)


solve()
