def max_sum_subarray(arr, k):
    n = len(arr)

    window_sum = sum(arr[:k])
    max_sum = window_sum

    for i in range(k, n):
        window_sum += arr[i]
        window_sum -= arr[i - k]

        max_sum = max(max_sum, window_sum)

    return max_sum


n = int(input("Enter N: "))
k = int(input("Enter K: "))

arr = list(map(int, input("Enter array elements: ").split()))

result = max_sum_subarray(arr, k)

print("Maximum Sum:", result)
