def maximize_adjacent_difference(arr):
    arr.sort()
    n = len(arr)

    result = []

    left = 0
    right = n - 1

    while left <= right:
        if left == right:
            result.append(arr[left])
        else:
            result.append(arr[left])
            result.append(arr[right])

        left += 1
        right -= 1

    total_sum = 0

    for i in range(n - 1):
        total_sum += abs(result[i] - result[i + 1])

    return result, total_sum


arr = list(map(int, input("Enter array elements separated by space: ").split()))

result, total_sum = maximize_adjacent_difference(arr)

print("Rearranged Array:", result)
print("Total Sum of Absolute Differences:", total_sum)
