arr = [4,2,7,1,3,5]
arr.sort()
n = len(arr)
result = []
i, j = 0, n - 1
while i <= j:
    if i <= j:
        result.append(arr[j])
        j -= 1
    if i <= j:
        result.append(arr[i])
        i += 1
total = 0
for k in range(n - 1):
    total += abs(result[k] - result[k + 1])
print("Rearranged Array:", result)
print("Maximum Sum:", total)
