import numpy as np
a=np.array([1,3,5,6])
a=np.append(a,4)
print("After push: ",a)
a=np.delete(a,-1)
print("Ater pop: ",a)
n=np.array([10,20,30,40,50])
while len(n)>0:
    popelement=n[-1]
    print("Popping this item :",popelement)
    n=np.delete(n,-1)
    print("Array after pop: ",n)

