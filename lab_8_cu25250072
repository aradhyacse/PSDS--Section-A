#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        int A[N];

        for (int i = 0; i < N; i++) {
            cin >> A[i];
        }

        int operations = 0;
        bool possible = true;

        for (int i = 0; i < N; i++) {
            if (A[i] < 0) {
                operations += -A[i];
            }
            else if (A[i] > 0) {
                possible = false;
            }
        }

        if (possible)
            cout << operations << endl;
        else
            cout << -1 << endl;
    }

    return 0;
}
