
#include <iostream>
#include <vector>
using namespace std;

int digitSum(int num) {
    num = abs(num);
    int sum = 0;

    while (num > 0) {
        sum += num % 10;
        num /= 10;
    }

    return sum;
}

int solve(int N, vector<int>& nums) {
    int count = 0;

    for (int i = 0; i < N; i++) {
        for (int j = i + 1; j < N; j++) {
            if (digitSum(nums[i]) == digitSum(nums[j])) {
                count++;
            }
        }
    }

    return count;
}

int main() {
    int N;
    cin >> N;

    vector<int> nums(N);

    for (int i = 0; i < N; i++) {
        cin >> nums[i];
    }

    cout << solve(N, nums) << endl;

    return 0;
}
