#include <iostream>
using namespace std;

void push(int arr[], int &top, int value)
{
    if (top == 99)
    {
        cout << "Stack Overflow!" << endl;
        return;
    }

    top++;
    arr[top] = value;
}

void pop(int arr[], int &top)
{
    if (top == -1)
    {
        cout << "Stack Underflow!" << endl;
        return;
    }

    cout << "Popped element: " << arr[top] << endl;
    top--;
}

int main()
{
    int arr[100];
    int n, top, value;
    char choice;

    cout << "Enter number of elements: ";
    cin >> n;

    cout << "Enter array elements: ";
    for (int i = 0; i < n; i++)
    {
        cin >> arr[i];
    }

    top = n - 1;

    cout << "Original stack: ";
    for (int i = 0; i <= top; i++)
    {
        cout << arr[i] << " ";
    }

    cout << "\n\nDo you want to push an element? (y/n): ";
    cin >> choice;

    if (choice == 'y' || choice == 'Y')
    {
        cout << "Enter element to push: ";
        cin >> value;

        push(arr, top, value);

        cout << "Stack after push: ";
        for (int i = 0; i <= top; i++)
        {
            cout << arr[i] << " ";
        }
        cout << endl;
    }

    cout << "\nDo you want to pop an element? (y/n): ";
    cin >> choice;

    if (choice == 'y' || choice == 'Y')
    {
        pop(arr, top);

        cout << "Stack after pop: ";
        for (int i = 0; i <= top; i++)
        {
            cout << arr[i] << " ";
        }
        cout << endl;
    }

    return 0;
}
