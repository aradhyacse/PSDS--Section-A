import heapq

# Min Heap / Priority Queue
h = []
for x in [30, 10, 20, 5, 40]:
    heapq.heappush(h, x)

print("Min Heap:", h)
print("Priority Queue Remove:", heapq.heappop(h))

# Max Heap
max_heap = []
for x in [30, 10, 20, 5, 40]:
    heapq.heappush(max_heap, -x)

print("Max Heap:", [-x for x in max_heap])
print("Maximum:", -heapq.heappop(max_heap))

# Heap Sort
arr = [30, 10, 20, 5, 40]
heapq.heapify(arr)

sorted_arr = [heapq.heappop(arr) for i in range(len(arr))]
print("Heap Sorted Array:", sorted_arr)

