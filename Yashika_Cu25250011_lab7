arr = list(map(int, input("Enter array elements: ").split()))

arr.sort()

result = []
i, j = 0, len(arr) - 1

while i <= j:
    if i == j:
        result.append(arr[i])
    else:
        result.append(arr[j])
        result.append(arr[i])
    i += 1
    j -= 1

total = sum(abs(result[k] - result[k - 1]) for k in range(1, len(result)))

print("Rearranged array:", result)
print("Maximum sum:", total)

