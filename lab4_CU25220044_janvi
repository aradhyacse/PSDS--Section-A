-- 1. Create Database
CREATE DATABASE CollegeDB;

-- Select Database
USE CollegeDB;


-- 2. Create Department Table
CREATE TABLE Department (
    dept_id INT PRIMARY KEY,
    dept_name VARCHAR(50) NOT NULL,
    hod_name VARCHAR(50)
);

