-- 14. Display Student Names with Department Names
SELECT Student.student_name, Department.dept_name
FROM Student
JOIN Department
ON Student.dept_id = Department.dept_id;


-- 15. Display Student Names with Course Names
SELECT Student.student_name, Course.course_name, Enrollment.grade
FROM Student
JOIN Enrollment ON Student.student_id = Enrollment.student_id
JOIN Course ON Enrollment.course_id = Course.course_id;


-- 16. Calculate Attendance Percentage
SELECT Student.student_name,
       Course.course_name,
       Attendance.attended_classes,
       Attendance.total_classes,
       ROUND(Attendance.attended_classes * 100.0 /
       NULLIF(Attendance.total_classes, 0), 2) AS attendance_percentage
FROM Attendance
JOIN Student ON Attendance.student_id = Student.student_id
JOIN Course ON Attendance.course_id = Course.course_id;


-- 17. Display Students Who Paid Less Than Total Fees
SELECT Student.student_name,
       Fees.total_fee,
       Fees.paid_fee,
       Fees.total_fee - Fees.paid_fee AS pending_fee
FROM Student
JOIN Fees ON Student.student_id = Fees.student_id
WHERE Fees.paid_fee < Fees.total_fee;


-- 18. Count Total Students
SELECT COUNT(*) AS total_students
