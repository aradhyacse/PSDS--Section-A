n = int(input())
arr = list(map(int, input().split()))

arr.sort()

ans = []
left = 0
right = n - 1

while left <= right:
    ans.append(arr[left])
    left += 1

    if left <= right:
        ans.append(arr[right])
        right -= 1

total = 0

for i in range(1, n):
    total += abs(ans[i] - ans[i - 1])

print("Rearranged Array:", ans)
print("Total Sum:", total)

