import heapq

# Priority Queue (Max Heap)
heap = []

for x in [30, 10, 50, 20, 40]:
    heapq.heappush(heap, -x)

print("Priority Queue Order:", end=" ")
while heap:
    print(-heapq.heappop(heap), end=" ")

# Heap Sort (Min Heap)
arr = [40, 10, 30, 50, 20]
heap = []

for x in arr:
    heapq.heappush(heap, x)

sorted_arr = []

while heap:
    sorted_arr.append(heapq.heappop(heap))

print("\nSorted Array:", sorted_arr)

