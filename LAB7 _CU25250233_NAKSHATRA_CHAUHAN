n = int(input())
arr = list(map(int, input().split()))
target = int(input())

left = 0
current_sum = 0
min_length = n + 1

for right in range(n):
    current_sum += arr[right]

    while current_sum > target:
        min_length = min(min_length, right - left + 1)
        current_sum -= arr[left]
        left += 1

if min_length == n + 1:
    print(-1)
else:
    print("Smallest Subarray Length:", min_length)
