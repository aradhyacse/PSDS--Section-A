# STACK OPERATIONS..
class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


class Stack:
    def __init__(self):
        self.top = None

    # PUSH
    def push(self, data):
        new_node = Node(data)
        new_node.next = self.top
        self.top = new_node
        print("After push:", data)

    # POP
    def pop(self):
        if self.top is None:
            print("Stack is empty")
        else:
            print("Popped:", self.top.data)
            self.top = self.top.next

    # DISPLAY
    def display(self):
        temp = self.top
        print("Stack:", end=" ")
        while temp:
            print(temp.data, end=" ")
            temp = temp.next
        print()


stack = Stack()

stack.push(10)
stack.push(20)
stack.push(30)
stack.display()

stack.pop()
stack.display()

