# Max Heapify
def max_heapify(arr, n, i):
    largest = i
    left = 2 * i + 1
    right = 2 * i + 2

    if left < n and arr[left] > arr[largest]:
        largest = left

    if right < n and arr[right] > arr[largest]:
        largest = right

    if largest != i:
        arr[i], arr[largest] = arr[largest], arr[i]
        max_heapify(arr, n, largest)


# Min Heapify
def min_heapify(arr, n, i):
    smallest = i
    left = 2 * i + 1
    right = 2 * i + 2

    if left < n and arr[left] < arr[smallest]:
        smallest = left

    if right < n and arr[right] < arr[smallest]:
        smallest = right

    if smallest != i:
        arr[i], arr[smallest] = arr[smallest], arr[i]
        min_heapify(arr, n, smallest)


# Build Max Heap
def build_max_heap(arr):
    n = len(arr)

    for i in range(n // 2 - 1, -1, -1):
        max_heapify(arr, n, i)


# Build Min Heap
def build_min_heap(arr):
    n = len(arr)

    for i in range(n // 2 - 1, -1, -1):
        min_heapify(arr, n, i)


# Heap Sort
def heap_sort(arr):
    n = len(arr)

    build_max_heap(arr)

    for i in range(n - 1, 0, -1):
        arr[0], arr[i] = arr[i], arr[0]
        max_heapify(arr, i, 0)


# Input
n = int(input("Enter number of elements: "))

arr = list(map(int, input("Enter elements: ").split()))

# Max Heap
max_heap = arr.copy()
build_max_heap(max_heap)

print("\nMax Heap:", max_heap)

# Min Heap
min_heap = arr.copy()
build_min_heap(min_heap)

print("Min Heap:", min_heap)

# Priority Queue using Max Heap
priority_queue = max_heap.copy()

print("Priority Queue (highest priority first):", end=" ")

while priority_queue:
    print(priority_queue[0], end=" ")

    priority_queue[0] = priority_queue[-1]
    priority_queue.pop()

    if priority_queue:
        max_heapify(priority_queue, len(priority_queue), 0)

print()

# Heap Sort
sorted_arr = arr.copy()
heap_sort(sorted_arr)

print("Heap Sorted Array:", sorted_arr)
