def solve():
    t = int(input("Enter number of test cases: "))

    for i in range(t):
        s = input("Enter the string: ").strip()
        freq = [0] * 26

        for ch in s:
            freq[ord(ch) - ord('a')] += 1

        ans = 0
        for count in freq:
            ans += count // 2

        print("Maximum number of palindromic subsequences:", ans)

solve()
