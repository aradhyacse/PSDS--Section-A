#include <iostream>
using namespace std;
struct Node{
    int data;
    Node *next;};

// STACK
Node *top = NULL;
// Push operation
void push(int value){
    Node *newNode = new Node;
    newNode->data = value;
    newNode->next = top;
    top = newNode;
    cout << value << " pushed into stack" << endl;}
// Pop operation
void pop(){
    if (top == NULL){
        cout << "Stack is empty" << endl;
        return;}
    Node *temp = top;
    cout << temp->data << " popped from stack" << endl;
    top = top->next;
    delete temp;}

// QUEUE
Node *front = NULL;
Node *rear = NULL;
// Enqueue operation
void enqueue(int value){
    Node *newNode = new Node;
    newNode->data = value;
    newNode->next = NULL;
    if (rear == NULL){
        front = rear = newNode;}
    else{
        rear->next = newNode;
        rear = newNode;}
    cout << value << " enqueued into queue" << endl;}
// Dequeue operation
void dequeue(){
    if (front == NULL){
        cout << "Queue is empty" << endl;
        return;}
    Node *temp = front;
    cout << temp->data << " dequeued from queue" << endl;
    front = front->next;
    if (front == NULL)
        rear = NULL;
    delete temp;}

int main(){
    cout << "STACK OPERATIONS" << endl;
    push(76);
    push(56);
    push(78);
    pop();
    cout << endl;
    cout << "QUEUE OPERATIONS" << endl;
    enqueue(12);
    enqueue(34);
    enqueue(47);
    dequeue();
    return 0;}
