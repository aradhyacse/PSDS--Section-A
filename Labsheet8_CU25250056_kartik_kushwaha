#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int n, k;
    cout << "Enter n: ";
    cin >> n;

    cout << "Enter k: ";
    cin >> k;

    vector<int> a(n);
    cout << "Enter array elements: ";
    for (int &x : a) cin >> x;

    long long sum = 0;

    for (int i = 0; i < k; i++)
        sum += a[i];

    long long ans = sum;

    for (int i = k; i < n; i++) {
        sum += a[i] - a[i - k];
        ans = max(ans, sum);
    }

    cout << "Maximum sum = " << ans;

    return 0;
}

