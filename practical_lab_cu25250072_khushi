
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int hammingDistance(int a, int x) {
    int count = 0;
    int n = a ^ x;

    while (n > 0) {
        count += n & 1;
        n >>= 1;
    }

    return count;
}

void solve() {
    int n, x;
    cin >> n >> x;

    vector<int> arr(n);

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    sort(arr.begin(), arr.end(), [x](int a, int b) {
        int d1 = hammingDistance(a, x);
        int d2 = hammingDistance(b, x);

        if (d1 != d2) {
            return d1 < d2;
        }

        return a < b;
    });

    for (int i = 0; i < n; i++) {
        if (i > 0) cout << " ";
        cout << arr[i];
    }

    cout << '\n';
}

int main() {
    int t;
    cin >> t;

    while (t--) {
        solve();
    }

    return 0;
}
