s = input()

seen = set()
left = 0
maximum = 0

for right in range(len(s)):
    while s[right] in seen:
        seen.remove(s[left])
        left += 1

    seen.add(s[right])
    maximum = max(maximum, right - left + 1)

print(maximum)

#Q3:
INF = float('inf')

n, m, k = map(int, input().split())

edges = []

for _ in range(m):
    u, v, w = map(int, input().split())
    edges.append((u, v, w))

# dp[node] = minimum cost to reach node
dp = [INF] * (n + 1)
dp[1] = 0

for _ in range(k):
    new_dp = dp.copy()

    for u, v, w in edges:
        if dp[u] != INF:
            new_dp[v] = min(new_dp[v], dp[u] + w)

        if dp[v] != INF:
            new_dp[u] = min(new_dp[u], dp[v] + w)

    dp = new_dp

if dp[n] == INF:
    print(-1)
else:
    print(dp[n])
